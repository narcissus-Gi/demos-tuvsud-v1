# ============================================================
# Application
# ============================================================

APP_ENV=development
RUN_MODE=mock
LOG_LEVEL=INFO
BUSINESS_TIMEZONE=Asia/Shanghai


# ============================================================
# LLM
# ============================================================

# mock、openai、openai_compatible 等
LLM_PROVIDER=mock

# RUN_MODE=mock 时可以留空
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=

LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2


# ============================================================
# LangGraph
# ============================================================

# memory 或 sqlite
CHECKPOINT_BACKEND=memory

# 仅 CHECKPOINT_BACKEND=sqlite 时使用
CHECKPOINT_DB_PATH=.runtime/checkpoints.sqlite3

GRAPH_RECURSION_LIMIT=50


# ============================================================
# Business execution limits
# ============================================================

MAX_MODEL_CALLS=6
MAX_TOOL_RETRIES=2
MAX_EXECUTION_SECONDS=60